{
  "name": "NotezZz",
  "short_name": "NotezZz",
  "description": "Fast sticky notes, synced to your Google Drive",
  "start_url": "/NotezZz/",
  "scope": "/NotezZz/",
  "display": "standalone",
  "background_color": "#16181d",
  "theme_color": "#16181d",
  "icons": [
    { "src": "/NotezZz/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/NotezZz/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "/NotezZz/share",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
