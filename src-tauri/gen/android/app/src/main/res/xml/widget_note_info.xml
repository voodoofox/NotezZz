<?xml version="1.0" encoding="utf-8"?>
<!-- List of every note. 30 min is the shortest schedule Android allows; the app also refreshes widgets whenever it leaves the foreground. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="180dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_list"
    android:previewLayout="@layout/widget_list"
    android:description="@string/widget_list_description"
    android:widgetCategory="home_screen" />
